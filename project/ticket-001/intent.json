    "architecture": {
      "status": "accepted",
      "decision": "Use Cython for explicitly selected Python modules and Cargo cdylib plus rlib for independent Rust kernels. A PEP517 backend packages both artifacts with an integrity manifest. A versioned C ABI permits cross-language sharing; explicit native selection fails on missing or corrupt binaries.",
      "components": [
        {
          "name": "build-backend",
          "paths": [
            "src/sorust/backend.py",
            "pyproject.toml",
            "MANIFEST.in",
            ".gitignore",
            "README.md",
            "CHANGELOG.md"
          ]
        },
        {
          "name": "python-runtime",
          "paths": [
            "src/sorust/__init__.py",
            "src/sorust/_compat.py"
          ]
        },
        {
          "name": "rust-kernel",
          "paths": [
            "crates/**",
            "include/**"
          ]
        },
        {
          "name": "validation-and-example",
          "paths": [
            "tests/**",
            "examples/**"
          ]
        },
        {
          "name": "standard",
          "paths": [
            "docs/**",
            "README.md"
          ]
        }
      ],
      "dataChanges": [],
      "interfaceChanges": [
        "PEP517 build hooks",
        "count_ascii_tokens Python API",
        "sorust C ABI v1"
      ],
      "responsibilityChanges": false,
