    "validation": [
      {
        "criterion": "AC-01",
        "commands": [
          "python -m build --no-isolation"
        ],
        "evidence": "Wheel and sdist rebuild each contain an importable compiled Python module and a Rust shared library with matching manifest hashes."
      },
      {
        "criterion": "AC-02",
        "commands": [
          "python -m pytest tests",
          "cargo test --locked --offline --manifest-path crates/sorust-kernel/Cargo.toml"
        ],
        "evidence": "Byte corpus parity, ABI null/empty checks, integrity rejection, independent wheel installation and Rust/C consumer reuse."
      },
      {
        "criterion": "AC-03",
        "commands": [
          "./project/governance-check.sh",
          "git diff --check"
        ],
        "evidence": "Bounded local governance and canonical documentation checks; no claim of remote approval."
      }
